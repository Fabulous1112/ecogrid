{
  "name": "ecogrid",
  "version": "0.1.0",
  "private": true,
  "description": "EcoGrid: verified clean-energy data on Base. Landing page and live 3D microgrid dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fabulous1112/ecogrid.git"
  },
  "homepage": "https://fabulous1112.github.io/ecogrid/",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "2.19.1",
    "postprocessing": "6.39.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.17",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
