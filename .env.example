# Copy to .env.local and fill in. Only variables prefixed with VITE_ reach the browser,
# so never put private keys or admin tokens here.

# URL of a running EcoGrid gateway. Leave empty to run the dashboard on built-in demo data.
VITE_GATEWAY_URL=

# Chain the wallet button asks for: 8453 = Base mainnet, 84532 = Base Sepolia.
VITE_CHAIN_ID=84532

# GridToken contract address, used to show the connected wallet's $GRID balance.
VITE_GRID_TOKEN_ADDRESS=
